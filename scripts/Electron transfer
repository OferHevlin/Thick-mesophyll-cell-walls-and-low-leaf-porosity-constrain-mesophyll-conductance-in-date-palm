import matplotlib.pyplot as plt
import pandas as pd
import numpy as np
import seaborn as sns
from matplotlib.lines import Line2D

# Load data
df = pd.read_csv('gm_fromLightcurve21.csv')

# Preprocessing
cols_to_clean = ['Jt', 'Jc', 'Jo', 'Rl', 'Qin']
for col in cols_to_clean:
    df[col] = pd.to_numeric(df[col], errors='coerce')

df_plot = df.dropna(subset=['Room', 'Qin']).copy()

# Visual settings
room_order = ['A', 'B', 'C', 'D']
new_colors = {'D': '#A6C1FF', 'C': '#B1A2F7', 'B': '#EA8AB9', 'A': '#FFB88A'}
temp_labels = {'A': '34/28', 'B': '28/22', 'C': '22/16', 'D': '16/10'}
room_markers = {'A': 'o', 'B': 's', 'C': '^', 'D': 'd'}
room_sizes = {'A': 11, 'B': 11, 'C': 15, 'D': 15}

sns.set_theme(style="whitegrid")

# Create 2x2 grid (standard web-friendly resolution)
fig, axes = plt.subplots(2, 2, figsize=(16, 14))
axes = axes.flatten()

configs = [
    ('Jt', '$J_{t}$ [$\mu mol \cdot m^{-2} \cdot s^{-1}$]', axes[0], '(a)'),
    ('Jc', '$J_{c}$ [$\mu mol \cdot m^{-2} \cdot s^{-1}$]', axes[1], '(b)'),
    ('Jo', '$J_{o}$ [$\mu mol \cdot m^{-2} \cdot s^{-1}$]', axes[2], '(c)'),
    ('Rl', '$R_{l}$ [$\mu mol \cdot m^{-2} \cdot s^{-1}$]', axes[3], '(d)')
]

legend_elements = []

for i, (y_col, ylabel, ax, panel_label) in enumerate(configs):
    data = df_plot.dropna(subset=[y_col]).copy()
    data.loc[data[y_col] < 0, y_col] = 0
    
    for room in room_order:
        room_df = data[data['Room'] == room]
        if room_df.empty: continue
        
        stats = room_df.groupby('Qin')[y_col].agg(['mean', 'sem']).reset_index().sort_values('Qin')
        x_pts = stats['Qin'].values
        y_pts = stats['mean'].values
        y_err = stats['sem'].fillna(0).values
        size = room_sizes[room]
        
        # Plot error bars and markers only (no lines, no shading)
        ax.errorbar(x_pts, y_pts, yerr=y_err, fmt=room_markers[room], color=new_colors[room],
                    ecolor=new_colors[room], elinewidth=1.8, capsize=4, markersize=size, 
                    markeredgecolor='white', markeredgewidth=1.5, alpha=1.0, zorder=4,
                    linestyle='None')

        if i == 0:
            legend_elements.append(Line2D([0], [0], color='none', marker=room_markers[room], 
                                         markersize=size, markerfacecolor=new_colors[room],
                                         markeredgecolor='white', markeredgewidth=1.2, 
                                         label=temp_labels[room]))

    ax.set_xlabel('$Q_{in}$ [$\mu mol \cdot m^{-2} \cdot s^{-1}$]', fontsize=20, labelpad=10)
    ax.set_ylabel(ylabel, fontsize=20, labelpad=10)
    ax.tick_params(axis='both', labelsize=16)
    ax.set_xlim(0, 2150)
    
    if y_col == 'Jt': ax.set_ylim(0, 200)
    elif y_col == 'Rl': ax.set_ylim(0, 7)
    else: 
        max_val = data[y_col].max()
        ax.set_ylim(0, max_val * 1.2 if max_val > 0 else 100)

    ax.text(0.03, 0.94, panel_label, transform=ax.transAxes, fontsize=22, fontweight='bold', va='top')
    ax.grid(True, linestyle='-', linewidth='1.0', color='#e0e0e0')

# Legend with markers only
fig.legend(handles=legend_elements, title='Growth Temperature ($^\circ$C)', 
           fontsize=18, title_fontsize='20', loc='lower center', 
           bbox_to_anchor=(0.5, -0.04), ncol=4, frameon=True)

plt.tight_layout(rect=[0, 0.03, 1, 1])
plt.savefig('combined_all_points_inline.png', dpi=150, bbox_inches='tight')
plt.show()
