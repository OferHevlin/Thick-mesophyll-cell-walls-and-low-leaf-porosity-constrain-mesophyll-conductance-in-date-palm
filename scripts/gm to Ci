import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from scipy.interpolate import UnivariateSpline
from matplotlib.lines import Line2D

# Load the data
filename = 'gm_fromAci_barplotClean.csv'
df = pd.read_csv(filename)

# Clean and Filter
plot_df = df.dropna(subset=['Room', 'gm', 'Ci', 'CO2_r_sp']).copy()
plot_df = plot_df[(plot_df['gm'] >= 0) & (plot_df['gm'] <= 0.6) & (plot_df['Ci'] <= 800)]

# Calculate means and SEM
stats_df = plot_df.groupby(['Room', 'CO2_r_sp']).agg(
    Ci_mean=('Ci', 'mean'), Ci_sem=('Ci', 'sem'),
    gm_mean=('gm', 'mean'), gm_sem=('gm', 'sem')
).reset_index()

# Visual settings
room_order = ['A', 'B', 'C', 'D']
new_colors = {'D': '#A6C1FF', 'C': '#B1A2F7', 'B': '#EA8AB9', 'A': '#FFB88A'}
temp_labels = {'A': '34/28', 'B': '28/22', 'C': '22/16', 'D': '16/10'}
room_markers = {'A': 'o', 'B': 's', 'C': '^', 'D': 'd'}
room_sizes = {'A': 13, 'B': 13, 'C': 18, 'D': 18}

plt.figure(figsize=(14, 10))
sns.set_theme(style="whitegrid")

legend_elements = []

for room in room_order:
    room_data = stats_df[stats_df['Room'] == room].sort_values('Ci_mean')
    if len(room_data) > 3:
        x = room_data['Ci_mean'].values
        y = room_data['gm_mean'].values
        y_err = room_data['gm_sem'].fillna(0).values
        x_err = room_data['Ci_sem'].fillna(0).values

        # Increased smoothing factor for 'more smooth' look
        # s parameter controls the smoothness vs fidelity. 
        # Using a value that allows a smooth curve while staying close to points.
        s_val = 0.0005 
        spl_mean = UnivariateSpline(x, y, s=s_val)
        spl_up = UnivariateSpline(x, y + y_err, s=s_val)
        spl_low = UnivariateSpline(x, y - y_err, s=s_val)
        
        x_dense = np.linspace(x.min(), x.max(), 500)
        y_smooth = spl_mean(x_dense)
        y_up_smooth = spl_up(x_dense)
        y_low_smooth = spl_low(x_dense)

        # Plot shaded error band
        plt.fill_between(x_dense, y_low_smooth, y_up_smooth, color=new_colors[room], alpha=0.15)
        
        # Plot the smooth trend line
        plt.plot(x_dense, y_smooth, color=new_colors[room], lw=3.5, alpha=0.9, zorder=3)
        
        # Plot markers and error bars
        size = room_sizes[room]
        plt.errorbar(x, y, xerr=x_err, yerr=y_err, fmt=room_markers[room], color=new_colors[room],
                     ecolor=new_colors[room], elinewidth=1.8, capsize=4, markersize=size, 
                     markeredgecolor='white', markeredgewidth=1.5, alpha=0.9, zorder=5)
        
        # Legend
        legend_elements.append(Line2D([0], [0], color=new_colors[room], lw=3.5, 
                                      marker=room_markers[room], markersize=size, 
                                      markeredgecolor='white', markeredgewidth=1.5, label=temp_labels[room]))

# Styling
plt.xlabel('$C_i$ [$\mu mol \cdot mol^{-1}$]', fontsize=28, labelpad=20)
plt.ylabel('$g_m$ [$mol \cdot m^{-2} \cdot s^{-1}$]', fontsize=28, labelpad=40)
plt.xticks(fontsize=22)
plt.yticks(fontsize=22)
plt.xlim(0, 800)
plt.ylim(0, 0.2)

plt.legend(handles=legend_elements, title='Growth Temp ($^\circ$C)', fontsize=20, title_fontsize='22', loc='upper left')
plt.grid(True, linestyle='-', linewidth='1.0', color='#e0e0e0')
plt.tight_layout()

# Save
plt.savefig('gm_vs_ci_extra_smooth.png', dpi=300)
plt.savefig('gm_vs_ci_extra_smooth.pdf')
plt.show()
